# Elastic User
ELASTIC_USER=elastic

# Password for the 'elastic' user (at least 6 characters)
ELASTIC_PASSWORD=changeme

# Kibana User
KIBANA_USER=kibana_system

# Kibana encryption key (min. 32 chars, used for saved objects, security, reporting)
KIBANA_ENCRYPTION_KEY=changeme_changeme_changeme_changeme_01

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=changeme

# Logstash User
LOGSTASH_USER=elastic

# Password for the 'logstash_system' user (at least 6 characters)
LOGSTASH_PASSWORD=changeme

# Version of Elastic products
STACK_VERSION=9.5.4

# Set the cluster name
CLUSTER_NAME=escluster01

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=trial
#LICENSE=basic

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9200
#ES_PORT=127.0.0.1:9200

# Port to expose Kibana to the host
KIBANA_PORT=5601
#KIBANA_PORT=80

# Increase or decrease based on the available host memory (in bytes)
MEM_LIMIT=1073741824

# PostgreSQL docker image
POSTGRES_DEFAULT_IMAGE=postgres:17-alpine

# PostgreSQL user (owner of POSTGRES_DB)
POSTGRES_USER=pgadmin

# Password for the PostgreSQL user (at least 6 characters)
POSTGRES_PASSWORD=changeme

# PostgreSQL database name
POSTGRES_DB=elasticdb

# Port to expose PostgreSQL to the host
POSTGRES_PORT=5432

# pgAdmin default login e-mail
PGADMIN_EMAIL=admin@servfolio.com

# Password for the pgAdmin default login (at least 6 characters)
PGADMIN_PASSWORD=admin123

# Port to expose pgAdmin to the host
PGADMIN_PORT=5050

