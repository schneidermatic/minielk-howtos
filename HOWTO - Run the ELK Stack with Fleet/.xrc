export PROJECT_HOME=$(pwd)
export RESOURCES_HOME="$PROJECT_HOME/../resources"

#==============================================================================
# SCRIPT:   .xrc
# AUTOHR:   Markus Schneider (schneidermatic)
# DATE:     2021-03-25
# REV:      0.5.0
# PLATFORM: noarch
# PURPOSE:  Shell environment file for the x_ command space
#==============================================================================

. "$RESOURCES_HOME/scripts/.xrc"

##----------------------------------------
## GET CERT DATA
##----------------------------------------
x_getcert() {
    docker cp es-cluster-es01-1:/usr/share/elasticsearch/config/certs/ca/ca.crt "$PROJECT_HOME/cert"
    openssl x509 -fingerprint -sha256 -noout -in "$PROJECT_HOME/cert/ca.crt" | awk -F"=" {' print $2 '} | sed s/://g > "$PROJECT_HOME/cert/ca.sha256"
    SHA256=$(cat "$PROJECT_HOME/cert/ca.sha256")
    CRT=$(cat "$PROJECT_HOME/cert/ca.crt")
    echo "$SHA256"
    echo ""
    echo "$CRT"
}